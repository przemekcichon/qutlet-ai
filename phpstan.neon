# PHPStan dla qutlet-ai (D-G2). Poziom startowy 5 — podnosimy osobnym punktem,
# gdy będzie realny kod do analizy. Stuby WordPressa dostarcza rozszerzenie
# szepeviktor/phpstan-wordpress (ładowane poniżej).
includes:
    - vendor/szepeviktor/phpstan-wordpress/extension.neon

parameters:
    level: 5
    paths:
        - qutlet-ai.php
        - src/
    excludePaths:
        - vendor/
    # Core AI Client (WP 7.0) — `php-stubs/wordpress-stubs` jeszcze go nie zna
    # (przypięty do ^6.6.2 przez szepeviktor/phpstan-wordpress). Patrz komentarz
    # w stubs/wp-ai-client.stub.php (P-7.1).
    # Stuby WooCommerce — twarda zależność (D-G5), konsumowana od P-7.3
    # (RewriteWriter/GenerationMetaBox: wc_get_product(), WC_Product,
    # WC_Product_Attribute). Stuby ACF Pro — `update_field()` w `TitleWriter`
    # (zapis `podnazwa` z referencją pola, P-13.2c — `opis` przeszedł na natywne
    # `post_content`/`wp_update_post()` w P-13.3b, ACF już niepotrzebne dla niego).
    scanFiles:
        - stubs/wp-ai-client.stub.php
        - vendor/php-stubs/woocommerce-stubs/woocommerce-stubs.php
        - vendor/php-stubs/acf-pro-stubs/acf-pro-stubs.php
    # Źródła qutlet-core (twarda zależność, D-G5) — RewriteGenerator/GenerationMetaBox
    # czytają stałe warstwy surowej (RawLayerMeta, P-7.3). Wzorzec 1:1 z
    # qutlet-allegro/phpstan.neon: ścieżka względna zakłada instalację WP
    # (pluginy-siostry w wp-content/plugins); analiza poza instalacją wymaga
    # obecności qutlet-core obok (jak vendor/ — lokalna materializacja środowiska).
    scanDirectories:
        - ../qutlet-core/src
